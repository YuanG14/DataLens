# Supabase project connection.
# Copy this file to .env and fill in real values from your Supabase dashboard
# (Project Settings -> Data API / API Keys). Never commit the real .env file.

# Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> Publishable key (safe for the browser)
# Do NOT put the "service_role" / secret key here — that key must never
# reach client-side code.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
